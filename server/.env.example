# Copy to .env and adjust.

# Planner: "claude" or "mock" (offline keyword rules)
WHATIF_PLANNER=claude
# local planner (WHATIF_PLANNER=local): vLLM's endpoint and model, see README "Local planner"
# WHATIF_LOCAL_URL=http://127.0.0.1:8001/v1
# WHATIF_LOCAL_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
# ANTHROPIC_API_KEY=sk-ant-...      (or log in once with `ant auth login`)
WHATIF_PLANNER_MODEL=claude-opus-5-5
WHATIF_PLANNER_EFFORT=low
WHATIF_PLANNER_FALLBACKS=1
# voice edits ("make it bigger"): low effort keeps them at 2-8 s
WHATIF_EDIT_EFFORT=low

# Image: "mock" or "sdxl_turbo" (needs requirements-gpu.txt)
WHATIF_IMAGE_PROVIDER=mock
WHATIF_IMAGE_STEPS=4
# re-generate with a new seed when the object is cut off at the image border
WHATIF_IMAGE_ATTEMPTS=3
WHATIF_REMOVE_BG=1
# background removal: "birefnet" (GPU, keeps foliage) or a rembg model name if rembg is installed
WHATIF_MATTING_MODEL=birefnet

# 3D: "none", "crossquad" (instant, crossed planes), "triposr" (GPU, ~3 s, blurry),
#     "spar3d" (GPU, ~7 s, much sharper; see README) or "command" (external tool)
WHATIF_MESH_PROVIDER=crossquad
# triangle budget per model (the headset renders many instances)
WHATIF_MESH_MAX_FACES=20000
# 0 = vertex colours; 1024 = baked texture (a little sharper, ~5 s and ~2 MB more per model)
WHATIF_MESH_TEXTURE_SIZE=0
# unlit models look like the billboards they came from
WHATIF_MESH_UNLIT=1
# WHATIF_TRIPOSR_DIR=third_party/TripoSR
WHATIF_TRIPOSR_RESOLUTION=256
# SPAR3D: 0 = swap with the image models on the GPU (~7 s per model, ~4 s per swap),
#         1 = low-VRAM mode, everything stays loaded (~30-40 s per model)
WHATIF_SPAR3D_LOW_VRAM=0
# GPU with ~20 GB free or more: 0 = image models and SPAR3D stay loaded together (no swaps,
# cut-outs and 3D models in parallel). 1 = swap them (16 GB GPUs).
WHATIF_GPU_SWAP=1
# 0 = the console log shows only word counts instead of what users said (privacy)
WHATIF_LOG_CONTENT=1
WHATIF_SPAR3D_TEXTURE_SIZE=1024
# WHATIF_MESH_COMMAND=python C:/tools/stable-fast-3d/run.py {input} --output-dir {output_dir}
WHATIF_MESH_TIMEOUT_S=300
